msgstr "Zu Geräten der Plattform"

#. translators: 1: topic id, 2: another topic id
#: classes/MetaBox.php:198
#, php-format
msgid "Send a message to all devices that are subscribed to '%1$s' and are also subscribed to the topic '%2$s'."
msgstr "Sende eine Nachricht an alle Geräte die ‚%1$s‘ und das Thema ‚%2$s‘ abonniert haben."

#. translators: 1: topic id, 2: another topic id
#: classes/MetaBox.php:206
#, php-format
msgid "Send a message to all devices that are subscribed to '%1$s' or to '%2$s' or to both topics."
msgstr "Sende eine Nachricht an alle Geräte die ‚%1$s‘ oder ‚%2$s‘ oder beide Themen abonniert haben."

#. translators: 1: topic id, 2: and 3: other topic ids
#: classes/MetaBox.php:216
#, php-format
msgid "Send a message to all devices that are subscribed to '%1$s' and are also subscribed to '%2$s' or to '%3$s' or to both topics."
msgstr "Sende eine Nachricht an alle Geräte die ‚%1$s‘ und eines der Themen ‚%2$s‘ oder ‚%3$s‘ oder beide abonniert haben."

#. translators: 1: topic id, 2: and 3: other topic ids
#: classes/MetaBox.php:223
#, php-format
msgid "Send a message to all devices that are subscribed to '%1$s' or are subscribed to both topics '%2$s' and '%3$s'."
msgstr "Sende eine Nachricht an alle Geräte die das Thema ‚%1$s‘ oder beide Themen ‚%2$s‘ und ‚%3$s‘ abonniert haben."

